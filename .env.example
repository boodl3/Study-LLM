# Copy to .env and fill in - compose reads .env automatically. .env is already gitignored.

# HMAC-SHA signing key for JWTs. The backend refuses to start if this is blank, and the
# algorithm needs at least 32 characters. Generate one:
#   openssl rand -base64 48
STUDYLLM_JWT_SECRET=

# Used by both the postgres service and the backend datasource. Note: Postgres applies this
# only on first init of the pgdata volume - changing it later needs `docker compose down -v`.
STUDYLLM_DB_PASSWORD=studyllm

# Where the backend finds Ollama. The default reaches the host from inside the container.
# Override it if another Docker/Swarm stack already publishes port 11434 - then run your own
# Ollama on a free port (OLLAMA_HOST=127.0.0.1:11435 ollama serve) and point here:
#STUDYLLM_OLLAMA_BASE_URL=http://host.docker.internal:11435

# Optional model overrides; these are the defaults. Must be pulled in your host Ollama.
#STUDYLLM_CHAT_MODEL=qwen3:8b
#STUDYLLM_EMBEDDING_MODEL=nomic-embed-text
#STUDYLLM_VISION_MODEL=llava:7b
